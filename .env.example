# IAM CLI - Configuracion de API Keys
# Copia este archivo como .env y reemplaza los valores

# FreeTheAi API
FREETHEAI_API_KEY=tu-api-key-aqui

# Gemini API (Google)
GEMINI_API_KEY=tu-api-key-aqui

# OpenCode API (MiMo v2.5)
OPENCODE_API_KEY=tu-api-key-aqui

# Proxy Server URLs (Cloudflare Worker - sin cold start)
FREETHEAI_PROXY_URL=https://iam-proxy.feabpemu12345.workers.dev
GEMINI_PROXY_URL=https://iam-proxy.feabpemu12345.workers.dev
OPENCODE_PROXY_URL=https://iam-proxy.feabpemu12345.workers.dev

# Password de acceso (opcional)
# ADMIN_PASSWORD=tu-password
